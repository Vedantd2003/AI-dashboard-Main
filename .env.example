# AlphaPulse AI — example environment. Copy to apps/api/.env and apps/web/.env.local for local development.
# Never commit real values. Optional integrations switch themselves off when their variables are empty.

# ───────── API (apps/api) ─────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Required. MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/alphapulse locally)
MONGODB_URI=
# Required in production, ≥ 32 random characters (Render generates one from the Blueprint)
SESSION_SECRET=
# Public URL of the web app; used for CORS, CSRF origin checks and links in emails
APP_BASE_URL=http://localhost:3000
# Public URL of this API (appears in the OpenAPI document)
API_PUBLIC_URL=http://localhost:4000
# Number of proxies in front of the API (Render: 1)
TRUST_PROXY=1

# Market data — https://twelvedata.com (free: 800 req/day, 8/min, US listings, internal non-display use)
TWELVE_DATA_API_KEY=
# News, profiles, metrics — https://finnhub.io (free: ~60 calls/min, non-commercial)
FINNHUB_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with a contact address
SEC_USER_AGENT="AlphaPulse you@example.com"

# AI analyst — https://openrouter.ai (model must support structured outputs)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Email — https://resend.com (both required to send mail)
RESEND_API_KEY=
EMAIL_FROM="AlphaPulse <alerts@yourdomain.com>"

# Workflows
SCHEDULER_ENABLED=false
N8N_WEBHOOK_SECRET=
N8N_BASE_URL=
# Optional. When set, workflow runs go through BullMQ; otherwise an in-process runner is used.
REDIS_URL=

RESEARCH_DAILY_LIMIT_PER_USER=20

# ───────── Web (apps/web) ─────────
# Server-only: where /api/v1/* is proxied. Read at build and start time. NOT exposed to the browser.
API_BASE_URL=http://localhost:4000
